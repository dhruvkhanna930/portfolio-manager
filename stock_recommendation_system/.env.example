# Stock Recommendation System - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Alpha Vantage API Keys (Optional)
# Get free keys from: https://www.alphavantage.co/
# These are optional - the system uses yfinance as primary source
# Multiple keys enable better rate limiting
# ============================================================================

ALPHAVANTAGE_KEY1=YOUR_ALPHA_VANTAGE_KEY_1
ALPHAVANTAGE_KEY2=YOUR_ALPHA_VANTAGE_KEY_2
ALPHAVANTAGE_KEY3=YOUR_ALPHA_VANTAGE_KEY_3
ALPHAVANTAGE_KEY4=YOUR_ALPHA_VANTAGE_KEY_4
ALPHAVANTAGE_KEY5=YOUR_ALPHA_VANTAGE_KEY_5
ALPHAVANTAGE_KEY6=YOUR_ALPHA_VANTAGE_KEY_6
ALPHAVANTAGE_KEY7=YOUR_ALPHA_VANTAGE_KEY_7

# ============================================================================
# Logging Configuration
# ============================================================================

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================================================
# Model Configuration
# ============================================================================

# Path to trained models (relative to this file)
MODELS_PATH=./models

# Whether to use trained ML models if available
USE_TRAINED_MODELS=true

# Whether to use sentiment analysis if available
USE_SENTIMENT_ANALYSIS=true

# Whether to use price forecasting
USE_PRICE_FORECASTING=true

# ============================================================================
# Performance Configuration
# ============================================================================

# Maximum number of stocks to process at once
MAX_STOCKS_BATCH=50

# Cache recommendations (in seconds)
CACHE_TTL=3600

# Request timeout (in seconds)
REQUEST_TIMEOUT=30

# ============================================================================
# Django Configuration (if using with Django)
# ============================================================================

# Set to true when integrating with Django
DJANGO_ENABLED=false

# Database connection string (if needed)
DATABASE_URL=sqlite:///db.sqlite3

# ============================================================================
# Notes
# ============================================================================

# Alpha Vantage:
# - Free tier: 5 calls per minute, 500 calls per day
# - Adding multiple keys helps distribute the rate limit
# - Not required - system works without them using yfinance

# Trained Models:
# - Requires TensorFlow to be installed
# - Models are in ./models/ directory
# - Set USE_TRAINED_MODELS=false to skip loading

# Performance:
# - Adjust CACHE_TTL based on your update frequency needs
# - Increase MAX_STOCKS_BATCH for better throughput (uses more memory)
# - Decrease for constrained environments
