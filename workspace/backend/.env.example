# Leave unset for local dev — config.py defaults to an absolute-path SQLite
# file at backend/dev.db. Set to a Postgres URL in prod, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/portfolio_manager
NEWS_API_KEY=
NEWS_API_PROVIDER=marketaux
FLASK_ENV=development
PRICE_SYNC_INTERVAL_MIN=30

# AI Suggestions — free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
